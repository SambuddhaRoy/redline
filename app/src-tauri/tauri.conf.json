{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redline",
  "mainBinaryName": "Redline",
  "version": "0.2.0",
  "identifier": "com.peregrine.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Redline",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../bootstrap.ps1": "bootstrap.ps1",
      "../../backend/": "backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3NzM2MEE1QjY3QjdBNUIKUldSYmVudTJwV0J6VjhFRjBUT1ZsbEM1bDlISFJtNnMrRDVxWitMVjY4Y1pZNjVBMXEzZ0pvOTkK",
      "endpoints": [
        "https://github.com/SambuddhaRoy/redline/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
